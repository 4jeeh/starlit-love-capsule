# Optional for Production Deployment (Vercel / Netlify):
# Set to the base URL of your private photo storage (without a trailing slash).
# Example: VITE_PRIVATE_MEDIA_BASE_URL=https://your-private-blob-url.public.blob.vercel-storage.com
# When left empty, the app loads from local `/memories` (which is git-ignored)
# and automatically falls back to Starlight Constellation SVG illustrations if files are not found.
VITE_PRIVATE_MEDIA_BASE_URL=
